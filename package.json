{
  "name": "my-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "docs:validate": "node scripts/validate-project-data.mjs",
    "docs:generate": "node scripts/project-docs.mjs",
    "docs:check": "node scripts/validate-project-data.mjs && node scripts/project-docs.mjs --check",
    "context:generate": "node scripts/project-docs.mjs",
    "release:prepare": "npm run docs:validate && npm run docs:generate && npm run format && npm run format:check && npm run lint && npm run build && npm run docs:check",
    "ai:generate": "node scripts/project-docs.mjs",
    "ai:check": "node scripts/validate-project-data.mjs && node scripts/project-docs.mjs --check",
    "context:check": "node scripts/project-docs.mjs --check"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "@tailwindcss/vite": "^4.3.3",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.26.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
